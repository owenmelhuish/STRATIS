# Netlify / Cloudflare Pages headers
# Security defaults for everything
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Heavy, rarely-changed assets: cache hard
/videos/*
  Cache-Control: public, max-age=604800
/favicon/*
  Cache-Control: public, max-age=2592000
/assets/*
  Cache-Control: public, max-age=2592000

# Styles/scripts share stable filenames, so keep the cache short
/css/*
  Cache-Control: public, max-age=3600
/js/*
  Cache-Control: public, max-age=3600

# HTML should always revalidate so content updates show immediately
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
